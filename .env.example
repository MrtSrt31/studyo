# Bu dosyayı ".env" olarak kopyala ve değerleri doldur
# cp .env.example .env

# ZORUNLU: En az 64 karakterlik rastgele bir değer
# Üretmek için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=buraya_cok_uzun_rastgele_bir_deger_yaz_en_az_64_karakter_olmali

# Sunucu portu (varsayılan: 3000)
PORT=3000

# Veritabanı dosya yolu (varsayılan: ./studyo.db)
DB_PATH=./studyo.db

# Üretim ortamında "production" yaz (HTTPS cookie için)
NODE_ENV=development
